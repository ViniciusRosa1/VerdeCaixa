  "info": {
    "title": "Verde Caixa API",
    "description": "",
    "version": "2.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "vc_access"
      },
      "csrf": {
        "type": "apiKey",
        "in": "header",
        "name": "x-csrf-token"
      }
    },
    "schemas": {
      "CreateFinancialEntryDto": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "INCOME",
              "EXPENSE"
            ]
          },
          "plan": {
            "type": "string",
            "enum": [
              "CASH",
              "INSTALLMENT",
              "RECURRING"
            ]
          },
          "description": {
            "type": "string"
          },
          "counterpartyId": {
            "type": "string",
            "format": "uuid"
          },
          "categoryId": {
            "type": "string",
            "format": "uuid"
          },
          "accountId": {
            "type": "string",
            "format": "uuid"
          },
          "projectId": {
            "type": "string",
            "format": "uuid"
          },
          "totalAmount": {
            "type": "number",
            "minimum": 0.01
          },
          "dueDate": {
            "type": "string",
            "format": "date"
          },
          "installmentCount": {
            "type": "number",
            "maximum": 120,
            "minimum": 2
          },
          "recurrenceEndsOn": {
            "type": "string",
            "format": "date"
          },
          "notes": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "plan",
          "description",
          "counterpartyId",
          "categoryId",
          "accountId",
          "totalAmount",
          "dueDate"
        ]
      },
      "UpdateFinancialEntryDto": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "counterpartyId": {
            "type": "string",
            "format": "uuid"
          },
          "categoryId": {
            "type": "string",
            "format": "uuid"
          },
          "accountId": {
            "type": "string",
            "format": "uuid"
          },
          "projectId": {
            "type": "string",
            "format": "uuid"
          },
          "totalAmount": {
            "type": "number",
            "minimum": 0.01
          },
          "dueDate": {
            "type": "string",
            "format": "date"
          },
          "notes": {
            "type": "string"
          }
        }
      },
      "SettleDto": {
        "type": "object",
        "properties": {
          "accountId": {
            "type": "string",
            "format": "uuid"
          },
          "settledAt": {
            "type": "string",
            "format": "date-time"
          },
          "notes": {
            "type": "string"
          }
        },
        "required": [
          "accountId"
        ]
      }
    }
  }
}