  },
  "dependencies": {
    "@tanstack/react-query": "^5.87.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "lucide-react": "^0.468.0",
    "next": "^16.3.4",
    "openapi-fetch": "^0.14.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "recharts": "3.8.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "openapi-typescript": "^7.9.1",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "type": "module"
