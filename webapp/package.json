{
  "name": "verde-caixa",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:sites": "next build && node scripts/prepare-sites.mjs",
    "start": "next start",
    "lint": "oxlint app components hooks lib",
    "format": "oxfmt"
    ,"api:dev": "npm --prefix api run dev"
